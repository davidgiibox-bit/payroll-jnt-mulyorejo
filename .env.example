FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=ganti-dengan-random-secret-key
DATABASE_URL=postgresql://user:password@localhost:5432/payroll_jnt

# Google Sheets — Absensi Internal J&T Express
# Isi salah satu: path file JSON service account, ATAU isi JSON-nya langsung (untuk Render env var)
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_CREDENTIALS_JSON_CONTENT=
# ID spreadsheet (dari URL: https://docs.google.com/spreadsheets/d/<ID_INI>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

